# Local development only. Never commit .env or live credentials.
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
SWAGGER_ENABLED=true
# release security security: production enables DB-shared credential throttling automatically.
# In test/development disabled unless explicitly enabled; production cannot disable it.
# Apply release security additive migration BEFORE starting a production app with this code.
AUTH_ABUSE_LIMIT_ENABLED=false
# Only trusted reverse proxy IPs/CIDRs; NEVER use 0.0.0.0/0 or "true".
# If empty, the socket IP is used and X-Forwarded-For is ignored.
TRUSTED_PROXY_CIDRS=
# Can leave empty for health/docs-only testing; auth will return 503 without a DB.
# Neon/VPS connection; use a pooled runtime URL in serverless deployments.
DATABASE_URL=
# Use the non-pooler URL for Prisma migrations if your provider requires one.
DIRECT_URL=
# Generate unique random bytes for this installation (32+ chars). Mandatory when DB is configured.
JWT_ACCESS_SECRET=
# customer identity / email verification: separate 32-byte AES-256-GCM key (64 hex characters).
# Required to REQUEST email verification. Never rotate while encrypted
# auth.email_verification.requested and auth.password_reset.requested
# outbox events remain pending until email delivery.
# Generate on Windows: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# email delivery email action tokens are delivered only when configured SMTP is enabled.
AUTH_ACTION_TOKEN_ENCRYPTION_KEY=

# Media: direct Cloudinary signed upload; optional until enabled.
MEDIA_CLOUD_NAME=
MEDIA_API_KEY=
MEDIA_API_SECRET=
MEDIA_NAMESPACE=projects/eshop

# Media-2A: choose per installation. Existing rows retain original provider.
# Cloudinary remains the default for backwards compatibility.
MEDIA_PROVIDER=cloudinary
# To switch new uploads to S3/R2, set MEDIA_PROVIDER=s3 and configure all six below.
# AWS example endpoint: https://s3.us-east-1.amazonaws.com; region us-east-1.
# R2 example endpoint: https://<accountid>.r2.cloudflarestorage.com; region auto.
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
# Public read URL for the bucket (CDN/Cloudflare custom domain or bucket public URL).
# Never use a private API endpoint as the public delivery URL.
MEDIA_S3_PUBLIC_BASE_URL=

# Media-2B: persistent VPS/Docker only. Not Vercel local disk.
# Existing Cloudinary/S3 media stays on the original stored provider.
# MEDIA_PROVIDER=disk
# Use an absolute path on a mounted, backed-up persistent volume.
MEDIA_DISK_ROOT=
# Bare origin accessible from Admin frontend for signed raw PUT.
MEDIA_DISK_API_BASE_URL=
# Bare origin used for published product image GET (can be CDN reverse proxy to API).
MEDIA_DISK_PUBLIC_BASE_URL=
# A dedicated random 32+ character secret, separate from JWT secrets.
MEDIA_DISK_UPLOAD_SECRET=

# Media-2C: OPTIONAL Cloudflare zone purge for S3/R2 and disk-backed public images.
# Both fields required together; token must have the least-privilege Zone.Cache Purge permission.
# Without a configured CDN purge, use short external CDN TTLs and expect stale cached images.
# Cloudinary requests invalidation with its own destroy API and does not use these settings.
MEDIA_CDN_CF_ZONE_ID=
MEDIA_CDN_CF_API_TOKEN=

# Stripe TEST mode only. Never place live Stripe keys in any environment.
# Stripe test intent creation is preparation ONLY; no client_secret is sent to
# buyers, no payment confirmation/capture and no order PAID transition yet.
STRIPE_TEST_ENABLED=false
# Explicit sandbox-only payment simulation; never enable in production.
STRIPE_TEST_CHECKOUT_ENABLED=false
STRIPE_TEST_REFUNDS_ENABLED=false
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=

# email delivery: disabled by default. Controlled mode sends only to the explicit allowlist.
EMAIL_DELIVERY_MODE=disabled
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=
# Google SMTP demo: App Password, never your primary Gmail password.
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Store
EMAIL_REPLY_TO=
# Bare origins only; HTTPS except local development.
EMAIL_PUBLIC_ORIGIN=
EMAIL_ADMIN_ORIGIN=
EMAIL_RECIPIENT_ALLOWLIST=

# push messaging: FCM HTTP v1, disabled until explicitly configured and validated.
PUSH_DELIVERY_MODE=disabled
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Service-account RSA PEM, with escaped newlines when required by deployment.
FCM_PRIVATE_KEY=
# Separate 32-byte random encryption key; never reuse JWT/action-token secrets.
PUSH_TOKEN_ENCRYPTION_KEY=
# Controlled mode: comma-separated canonical user UUIDs, never raw device tokens.
PUSH_RECIPIENT_USER_IDS=
PUSH_STOREFRONT_ORIGIN=
PUSH_ADMIN_ORIGIN=

# durable jobs scheduler: disabled by default. Explicitly allow bounded lanes after provider review.
# Set the same value as Vercel CRON_SECRET for Bearer authentication.
JOBS_CRON_ENABLED=false
JOBS_CRON_SECRET=
JOBS_ALLOWED_LANES=

# Cloudinary Console folder mode: dynamic for new accounts; fixed for legacy accounts.
MEDIA_CLOUDINARY_FOLDER_MODE=dynamic
