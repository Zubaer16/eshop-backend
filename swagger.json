                    },
                    "name": {
                      "type": "string"
                    },
                    "slug": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string",
                      "nullable": true
                    },
                    "originalPrice": {
                      "type": "number"
                    },
                    "salePrice": {
                      "type": "number",
                      "nullable": true
                    },
                    "stock": {
                      "type": "integer"
                    },
                    "categoryId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "isOnSale": {
                      "type": "boolean"
                    },
                    "saleStartDate": {
                      "type": "string",
                      "nullable": true,
                      "format": "date-time"
                    },
                    "saleEndDate": {
                      "type": "string",
                      "nullable": true,
                      "format": "date-time"
                    },
                    "isActive": {
                      "type": "boolean"
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time"
