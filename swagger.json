                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "description": {
                    "type": "string"
                  },
                  "originalPrice": {
                    "type": "number",
                    "minimum": 0,
                    "exclusiveMinimum": true
                  },
                  "salePrice": {
                    "type": "number",
                    "minimum": 0,
                    "exclusiveMinimum": true
                  },
                  "stock": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "categoryId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "isOnSale": {
