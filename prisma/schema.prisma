// Phase 02: canonical identities, accounts/sessions, skeleton catalog, durable outbox.
// DO NOT import mismatched Storefront/Admin demo fixtures as production truth.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
  OWNER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique @db.VarChar(320)
  displayName  String        @default("") @map("display_name") @db.VarChar(120)
  passwordHash String        @map("password_hash") @db.Text
  sessionVersion Int         @default(0) @map("session_version")
  role         UserRole      @default(CUSTOMER)
  status       UserStatus    @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  pushDevices PushDevice[]
  pushCampaignAudience PushCampaignAudience[]
  pushCampaignRecipients PushCampaignRecipient[]
  emailDeliveries EmailDelivery[]
  notificationRecipients NotificationRecipient[]
  notificationPreference NotificationPreference?
  sessions     AuthSession[]
  auditEvents  AuditEvent[]
  staffRoleAssignment StaffRoleAssignment?
  cart Cart?
  mergedGuestCarts GuestCart[]
  checkoutReservations CheckoutReservation[]
  orders Order[]
  wishlistItems WishlistItem[]
  customerAddresses CustomerAddress[]
  emailVerifiedAt DateTime? @map("email_verified_at")
  emailVerification EmailVerificationChallenge?
  passwordReset PasswordResetChallenge?

  @@map("users")
  @@index([role,createdAt,id])
}

// G2 / 05A-5: one revocable, time-limited email verification challenge
// per customer. Only a SHA-256 digest is persisted; delivery payload is AEAD-encrypted.
model EmailVerificationChallenge {
  userId       String    @id @map("user_id") @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt    DateTime  @map("expires_at")
  requestedAt  DateTime  @default(now()) @map("requested_at")
  consumedAt   DateTime? @map("consumed_at")

  @@index([expiresAt])
  @@map("email_verification_challenges")
}

// G2 / 05A-6: one revocable password recovery token per customer.
// Only a SHA-256 digest persists. The G7 delivery token is encrypted in outbox.
model PasswordResetChallenge {
  userId        String    @id @map("user_id") @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique @map("token_hash") @db.VarChar(64)
  requestedAt   DateTime  @default(now()) @map("requested_at")
  expiresAt     DateTime  @map("expires_at")
  consumedAt    DateTime? @map("consumed_at")
  windowStartAt DateTime  @map("window_start_at")
  windowCount   Int       @default(1) @map("window_count")

  @@index([expiresAt])
  @@map("password_reset_challenges")
}

model AuthSession {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId    String    @map("family_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.VarChar(64)
  sessionVersion Int   @default(0) @map("session_version")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId, familyId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action      String   @db.VarChar(120)
  targetType  String   @map("target_type") @db.VarChar(80)
  targetId    String?  @map("target_id") @db.VarChar(128)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("audit_events")
  @@index([actorId,createdAt,id])
  @@index([targetType,createdAt,id])
}

model Category {
  coupons Coupon[]
  id          String       @id @default(uuid()) @db.Uuid
  slug        String       @unique @db.VarChar(160)
  name        String       @db.VarChar(200)
  description String       @default("") @db.Text
  // Frontend navigation metadata; active hides category from navigation, not products.
  color       String       @default("#EAF0FF") @db.VarChar(7)
  sortOrder   Int          @default(0) @map("sort_order")
  active      Boolean      @default(true)
  parentId    String?      @map("parent_id") @db.Uuid
  parent      Category?    @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[]   @relation("CategoryTree")
  products    ProductCategory[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([parentId])
  @@map("categories")
}

model Product {
  id             String         @id @default(uuid()) @db.Uuid
  slug           String         @unique @db.VarChar(200)
  title          String         @db.VarChar(250)
  sku            String?        @unique @db.VarChar(120)
  description    String         @default("") @db.Text
  badge          String         @default("") @db.VarChar(80)
  tag            String?        @db.VarChar(16)
  status         ProductStatus  @default(DRAFT)
  currency       String         @default("USD") @db.VarChar(3)
  priceMinor     Int            @map("price_minor")
  compareAtMinor Int?           @map("compare_at_minor")
  // Simple product: stockOnHand is authoritative. With variants: variant stock is.
  hasVariants    Boolean        @default(false) @map("has_variants")
  stockOnHand    Int            @default(0) @map("stock_on_hand")
  variants       ProductVariant[]
  inventoryBalance InventoryBalance?
  categories     ProductCategory[]
  media          ProductMedia[]
  cartItems     CartItem[]
  guestCartItems GuestCartItem[]
  wishlistItems WishlistItem[]
  featuredLinks FeaturedCollectionProduct[]
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@index([status])
  @@map("products")
}

model ProductVariant {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku         String   @unique @db.VarChar(120)
  options     Json     @default("{}")
  priceMinor  Int?     @map("price_minor")
  stockOnHand Int      @default(0) @map("stock_on_hand")
  inventoryBalance InventoryBalance?
  cartItems   CartItem[]
  guestCartItems GuestCartItem[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@map("product_variants")
}

// 05A-1: Persistent customer-only product bookmarks. Never records money, stock,
// order, price promises or anonymous capability tokens.
model WishlistItem {
  userId     String   @map("user_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([userId, createdAt])
  @@map("wishlist_items")
}

// 05A-2: private, customer-owned address book. Order shipping snapshots are separate.
// Only a customer-profile API uses this table; it never updates existing orders.
model CustomerAddress {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String   @default("Home") @db.VarChar(40)
  recipientName String   @map("recipient_name") @db.VarChar(120)
  phone         String   @db.VarChar(16)
  addressLine1  String   @map("address_line_1") @db.VarChar(200)
  addressLine2  String   @default("") @map("address_line_2") @db.VarChar(200)
  city          String   @db.VarChar(100)
  region        String   @default("") @db.VarChar(100)
  postalCode    String   @default("") @map("postal_code") @db.VarChar(20)
  countryCode   String   @map("country_code") @db.VarChar(2)
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@map("customer_addresses")
}

model ProductCategory {
  productId  String   @map("product_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("product_categories")
}

enum InventoryReason {
  OPENING
  RECEIPT
  RETURN
  DAMAGE
  CORRECTION
  SALE
  REPLACEMENT
}

// Exactly one of productId/variantId is populated (also checked by SQL).
// The existing Catalog stockOnHand fields remain backward-compatible mirrors;
// all post-creation writes must go through the Inventory service.
model InventoryBalance {
  id                String             @id @default(uuid()) @db.Uuid
  productId         String?            @unique @map("product_id") @db.Uuid
  variantId         String?            @unique @map("variant_id") @db.Uuid
  product           Product?           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant           ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  onHand            Int                @default(0) @map("on_hand")
  lowStockThreshold Int                @default(5) @map("low_stock_threshold")
  movements         InventoryMovement[]
  reservedQuantity  Int                @default(0) @map("reserved_quantity")
  reservationLines  CheckoutReservationLine[]
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@map("inventory_balances")
}

// Append-only through the HTTP API. requestId is unique per inventory item
// to make retries safe even if the HTTP caller loses the first response.
model InventoryMovement {
  id         String          @id @default(uuid()) @db.Uuid
  balanceId  String          @map("balance_id") @db.Uuid
  balance    InventoryBalance @relation(fields: [balanceId], references: [id], onDelete: Cascade)
  requestId  String          @map("request_id") @db.Uuid
  reason     InventoryReason
  delta      Int
  before     Int
  after      Int
  note       String          @default("") @db.VarChar(500)
  actorId    String?         @map("actor_id") @db.Uuid
  createdAt  DateTime        @default(now()) @map("created_at")

  @@unique([balanceId, requestId])
  @@index([balanceId, createdAt])
  @@map("inventory_movements")
}

model OutboxEvent {
  pushCampaign PushCampaign?
  pushReceipt PushEventReceipt?
  pushDeliveries PushDelivery[]
  emailReceipt EmailEventReceipt?
  emailDeliveries EmailDelivery[]
  notificationReceipt NotificationEventReceipt?
  id          String       @id @default(uuid()) @db.Uuid
  eventType   String       @map("event_type") @db.VarChar(150)
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now()) @map("available_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([eventType, createdAt, id], map: "outbox_events_notification_scan_idx")
  @@index([status, availableAt])
  @@map("outbox_events")
}

model IdempotencyRecord {
  id          String   @id @default(uuid()) @db.Uuid
  scope       String   @db.VarChar(120)
  key         String   @db.VarChar(200)
  requestHash String   @map("request_hash") @db.VarChar(64)
  response    Json?
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

// A1: one persisted Admin workspace role per staff member, five seeded roles.
// Role -> permission decisions are always made server-side, never from JWT claims.
model StaffRole {
  key         String                @id @db.VarChar(40)
  displayName String                @map("display_name") @db.VarChar(80)
  permissions StaffRolePermission[]
  assignments StaffRoleAssignment[]

  @@map("staff_roles")
}
model StaffRolePermission {
  roleKey       String    @map("role_key") @db.VarChar(40)
  permissionKey String    @map("permission_key") @db.VarChar(80)
  role          StaffRole @relation(fields: [roleKey], references: [key], onDelete: Restrict)

  @@id([roleKey, permissionKey])
  @@map("staff_role_permissions")
}
model StaffRoleAssignment {
  userId     String    @id @map("user_id") @db.Uuid
  roleKey    String    @map("role_key") @db.VarChar(40)
  assignedAt DateTime  @default(now()) @map("assigned_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       StaffRole @relation(fields: [roleKey], references: [key], onDelete: Restrict)

  @@index([roleKey])
  @@map("staff_role_assignments")
}

// Phase 03C: media metadata, non-public provider identities and shared references.
enum MediaAssetStatus {
  PENDING_UPLOAD
  ACTIVE
  PENDING_DELETE
  DELETED
  DELETE_FAILED
}

enum MediaDeletionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model MediaAsset {
  pushCampaignRefs PushCampaign[]
  pushDeliveryRefs PushDelivery[]
  notificationImageRefs Notification[]
  id                 String            @id @default(uuid()) @db.Uuid
  provider           String            @db.VarChar(40)
  namespace          String            @db.VarChar(160)
  objectKey          String            @unique @map("object_key") @db.VarChar(500)
  providerAssetId    String?           @map("provider_asset_id") @db.VarChar(200)
  mimeType           String            @map("mime_type") @db.VarChar(80)
  bytes              Int               @default(0)
  width              Int               @default(0)
  height             Int               @default(0)
  publicUrl          String?           @map("public_url") @db.Text
  renditions         Json?             @db.JsonB // Phase 03C-2C2: READY widths only
  status             MediaAssetStatus  @default(PENDING_UPLOAD)
  uploadExpiresAt    DateTime          @map("upload_expires_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  productLinks       ProductMedia[]
  brandLogoRefs      StoreBranding[] @relation("StoreBrandLogo")
  brandFaviconRefs   StoreBranding[] @relation("StoreBrandFavicon")
  bannerRefs StoreBanner[]
  deletionJob        MediaDeletionJob?

  @@index([status, uploadExpiresAt])
  @@map("media_assets")
}

model ProductMedia {
  productId String      @map("product_id") @db.Uuid
  mediaId   String      @map("media_id") @db.Uuid
  position  Int         @default(0)
  altText   String      @default("") @map("alt_text") @db.VarChar(250)
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  media     MediaAsset  @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([productId, mediaId])
  @@index([mediaId])
  @@map("product_media")
}

model MediaDeletionJob {
  id          String              @id @default(uuid()) @db.Uuid
  mediaId     String              @unique @map("media_id") @db.Uuid
  media       MediaAsset          @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  status      MediaDeletionStatus @default(PENDING)
  attempts    Int                 @default(0)
  availableAt DateTime            @map("available_at")
  claimedAt   DateTime?           @map("claimed_at")
  lastError   String?             @map("last_error") @db.VarChar(250)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@index([status, availableAt])
  @@map("media_deletion_jobs")
}

// Phase 04A-1: customer-owned, persistent cart. A cart is not a stock hold.
// Guest ownership, address, taxes, delivery and order creation arrive later.
model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @map("user_id") @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  checkoutReservations CheckoutReservation[]
  orders Order[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("carts")
}

model CartItem {
  id        String          @id @default(uuid()) @db.Uuid
  cartId    String          @map("cart_id") @db.Uuid
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String          @map("product_id") @db.Uuid
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?         @map("variant_id") @db.Uuid
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  // For variant lines; SQL adds separate partial unique index for simple products.
  @@unique([cartId, productId, variantId], map: "cart_items_cart_product_variant_key")
  @@index([productId])
  @@index([variantId])
  @@map("cart_items")
}

// Anonymous cart capability: token is returned ONCE, only its SHA-256 hash is stored.
// Guest ownership is never inferred from email, IP, User-Agent, or browser cookies.
model GuestCart {
  id           String    @id @default(uuid()) @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt    DateTime  @map("expires_at")
  mergedUserId String?   @map("merged_user_id") @db.Uuid
  mergedUser   User?     @relation(fields: [mergedUserId], references: [id], onDelete: SetNull)
  mergedAt     DateTime? @map("merged_at")
  items        GuestCartItem[]
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("guest_carts")
}

model GuestCartItem {
  id          String          @id @default(uuid()) @db.Uuid
  guestCartId String          @map("guest_cart_id") @db.Uuid
  guestCart   GuestCart       @relation(fields: [guestCartId], references: [id], onDelete: Cascade)
  productId   String          @map("product_id") @db.Uuid
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId   String?         @map("variant_id") @db.Uuid
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity    Int
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@unique([guestCartId, productId, variantId], map: "guest_cart_items_line_key")
  @@index([productId])
  @@index([variantId])
  @@map("guest_cart_items")
}

// 04B-1: Explicit, owner-maintained country/currency checkout estimate policy.
// No default jurisdiction, no implicit free shipping, no stock hold or order.
model CheckoutRate {
  id                     String   @id @default(uuid()) @db.Uuid
  countryCode            String   @map("country_code") @db.VarChar(2)
  currency               String   @db.VarChar(3)
  shippingMinor          Int      @map("shipping_minor")
  freeOverSubtotalMinor  Int?     @map("free_over_subtotal_minor")
  taxBps                 Int      @map("tax_bps")
  enabled                Boolean  @default(true)
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@unique([countryCode, currency], map: "checkout_rates_country_currency_key")
  @@map("checkout_rates")
}

// 04B-2: time-limited stock holds; not an order or payment intent.
enum CheckoutReservationStatus {
  ACTIVE
  RELEASED
  EXPIRED
  CONSUMED
}

model CheckoutReservation {
  id                  String   @id @default(uuid()) @db.Uuid
  customerId          String   @map("customer_id") @db.Uuid
  customer            User     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  cartId              String   @map("cart_id") @db.Uuid
  cart                Cart     @relation(fields: [cartId], references: [id], onDelete: Restrict)
  requestId           String   @map("request_id") @db.Uuid
  status              CheckoutReservationStatus @default(ACTIVE)
  countryCode         String   @map("country_code") @db.VarChar(2)
  currency            String   @db.VarChar(3)
  subtotalMinor       Int      @map("subtotal_minor")
  shippingMinor       Int      @map("shipping_minor")
  deliveryKind        DeliveryKind? @map("delivery_kind")
  taxMinor            Int      @map("tax_minor")
  estimatedTotalMinor Int      @map("estimated_total_minor")
  createdAt           DateTime @default(now()) @map("created_at")
  expiresAt           DateTime @map("expires_at")
  releasedAt          DateTime? @map("released_at")
  discountMinor       Int @default(0) @map("discount_minor")
  couponCode          String? @map("coupon_code") @db.VarChar(24)
  couponSnapshot      Json? @map("coupon_snapshot") @db.JsonB
  couponRedemption    CouponRedemption?
  lines               CheckoutReservationLine[]
  order               Order?

  @@unique([customerId, requestId], map: "checkout_reservations_customer_request_key")
  @@index([status, expiresAt])
  @@map("checkout_reservations")
}

model CheckoutReservationLine {
  id            String @id @default(uuid()) @db.Uuid
  reservationId String @map("reservation_id") @db.Uuid
  reservation   CheckoutReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  balanceId     String @map("balance_id") @db.Uuid
  balance       InventoryBalance @relation(fields: [balanceId], references: [id], onDelete: Restrict)
  productId     String @map("product_id") @db.Uuid
  variantId     String? @map("variant_id") @db.Uuid
  quantity      Int
  unitPriceMinor Int @map("unit_price_minor")
  discountMinor Int @default(0) @map("discount_minor")

  @@index([balanceId])
  @@map("checkout_reservation_lines")
}

// 04C-1: unpaid order intent owns the former reservation allocation.
// Stock stays physically onHand until a future verified payment/fulfillment step.
// reservedQuantity covers ACTIVE holds plus PENDING_PAYMENT order allocations.
enum OrderStatus {
  PENDING_PAYMENT
  CANCELLED
  EXPIRED
  PAID
}

model Order {
  id                String      @id @default(uuid()) @db.Uuid
  customerId        String      @map("customer_id") @db.Uuid
  customer          User        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  cartId            String      @map("cart_id") @db.Uuid
  cart              Cart        @relation(fields: [cartId], references: [id], onDelete: Restrict)
  reservationId     String      @unique @map("reservation_id") @db.Uuid
  reservation       CheckoutReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  requestId         String      @map("request_id") @db.Uuid
  requestHash       String      @map("request_hash") @db.VarChar(64)
  status            OrderStatus @default(PENDING_PAYMENT)
  countryCode       String      @map("country_code") @db.VarChar(2)
  currency          String      @db.VarChar(3)
  subtotalMinor     Int         @map("subtotal_minor")
  shippingMinor     Int         @map("shipping_minor")
  deliveryKind      DeliveryKind? @map("delivery_kind")
  taxMinor          Int         @map("tax_minor")
  totalMinor        Int         @map("total_minor")
  discountMinor     Int @default(0) @map("discount_minor")
  couponCode        String? @map("coupon_code") @db.VarChar(24)
  couponSnapshot    Json? @map("coupon_snapshot") @db.JsonB
  shippingAddress   Json        @map("shipping_address") @db.JsonB
  paymentDeadlineAt DateTime    @map("payment_deadline_at")
  closedAt          DateTime?   @map("closed_at")
  paidAt            DateTime?   @map("paid_at")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  lines             OrderLine[]
  statusEvents      OrderStatusEvent[]
  paymentAttempt    PaymentAttempt?
  paymentTransaction PaymentTransaction?
  refundRequests RefundRequest[]
  shipment OrderShipment?
  returnRequests OrderReturn[]
  replacements OrderReplacement[]

  @@unique([customerId, requestId], map: "orders_customer_request_key")
  @@index([status, paymentDeadlineAt])
  @@index([customerId, createdAt])
  @@map("orders")
  @@index([createdAt,id])
}

// No live product/variant FK: historical invoice snapshot survives catalog removal.
model OrderLine {
  id                  String  @id @default(uuid()) @db.Uuid
  orderId             String  @map("order_id") @db.Uuid
  order               Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String  @map("product_id") @db.Uuid
  variantId           String? @map("variant_id") @db.Uuid
  titleSnapshot       String  @map("title_snapshot") @db.VarChar(250)
  skuSnapshot         String? @map("sku_snapshot") @db.VarChar(120)
  optionsSnapshotJson String  @map("options_snapshot_json") @db.Text
  quantity            Int
  unitPriceMinor      Int     @map("unit_price_minor")
  lineTotalMinor      Int     @map("line_total_minor")
  discountMinor       Int @default(0) @map("discount_minor")
  returnRequests      OrderReturn[]

  @@index([orderId])
  @@map("order_lines")
}

model OrderStatusEvent {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @map("order_id") @db.Uuid
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  reason    String      @db.VarChar(80)
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("order_status_events")
}

// 04C-2A: test-mode Stripe intent is PREPARATION ONLY, never a payable checkout.
// Future settlement must reconcile a verified intent before touching orders or stock.
enum PaymentAttemptStatus {
  CREATING
  READY
  REQUIRES_REVIEW
  SETTLED
  CANCELLING
  CANCELLED
  CONFIRMING
  CAPTURING
  AWAITING_WEBHOOK
}

model PaymentAttempt {
  id                String @id @default(uuid()) @db.Uuid
  orderId           String @unique @map("order_id") @db.Uuid
  order             Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider          String @default("STRIPE_TEST") @db.VarChar(30)
  providerIntentId  String? @unique @map("provider_intent_id") @db.VarChar(128)
  idempotencyKey    String @unique @map("idempotency_key") @db.VarChar(200)
  status            PaymentAttemptStatus @default(CREATING)
  amountMinor       Int @map("amount_minor")
  currency          String @db.VarChar(3)
  creationStartedAt DateTime @default(now()) @map("creation_started_at")
  cancellationStartedAt DateTime? @map("cancellation_started_at")
  cancellationRetryAt DateTime @default(now()) @map("cancellation_retry_at")
  cancellationAttempts Int @default(0) @map("cancellation_attempts")
  testCompletionStartedAt DateTime? @map("test_completion_started_at")
  testCompletionAttempts Int @default(0) @map("test_completion_attempts")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  transaction       PaymentTransaction?

  @@index([status, creationStartedAt])
  @@index([status, cancellationRetryAt])
  @@map("payment_attempts")
  @@index([createdAt,id])
}

// Signed delivery receipt only. Do not persist Stripe raw payload (PII) or
// treat event receipt as proof that the order was paid or inventory finalized.
model PaymentWebhookReceipt {
  id                String @id @default(uuid()) @db.Uuid
  providerEventId   String @unique @map("provider_event_id") @db.VarChar(128)
  eventType         String @map("event_type") @db.VarChar(120)
  providerIntentId  String? @map("provider_intent_id") @db.VarChar(128)
  payloadSha256     String @map("payload_sha256") @db.VarChar(64)
  status            String @default("RECEIVED") @db.VarChar(30)
  receivedAt        DateTime @default(now()) @map("received_at")
  processedAt       DateTime? @map("processed_at")
  processingAt      DateTime? @map("processing_at")
  retryAt           DateTime @default(now()) @map("retry_at")
  attempts          Int @default(0)

  @@index([providerIntentId])
  @@index([status, receivedAt])
  @@map("payment_webhook_receipts")
}

// 04C-2B1: recorded only after a freshly retrieved TEST payment intent is
// provider-confirmed succeeded and inventory + order commit together.
model PaymentTransaction {
  id               String @id @default(uuid()) @db.Uuid
  orderId          String @unique @map("order_id") @db.Uuid
  order            Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentAttemptId String @unique @map("payment_attempt_id") @db.Uuid
  paymentAttempt   PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  providerIntentId String @unique @map("provider_intent_id") @db.VarChar(128)
  amountMinor      Int @map("amount_minor")
  currency         String @db.VarChar(3)
  createdAt        DateTime @default(now()) @map("created_at")

  refundRequests RefundRequest[]

  @@map("payment_transactions")
  @@index([createdAt,currency])
}

// 04C-2B2C2: OWNER-approved amount allocations are executed by an explicit
// Stripe TEST worker; provider-refetched status determines success. No restock.
enum RefundRequestStatus {
  REQUESTED
  PROCESSING
  SUCCEEDED
  FAILED
  REQUIRES_REVIEW
}

model RefundRequest {
  id                   String @id @default(uuid()) @db.Uuid
  orderId              String @map("order_id") @db.Uuid
  order                Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentTransactionId String @map("payment_transaction_id") @db.Uuid
  paymentTransaction   PaymentTransaction @relation(fields: [paymentTransactionId], references: [id], onDelete: Restrict)
  requestId            String @map("request_id") @db.Uuid
  amountMinor          Int @map("amount_minor")
  currency             String @db.VarChar(3)
  reason               String @db.VarChar(32)
  status               RefundRequestStatus @default(REQUESTED)
  requestedById        String @map("requested_by_id") @db.Uuid
  providerRefundId     String? @unique @map("provider_refund_id") @db.VarChar(128)
  providerStatus       String? @map("provider_status") @db.VarChar(30)
  processingStartedAt  DateTime? @map("processing_started_at")
  firstSubmittedAt     DateTime? @map("first_submitted_at")
  retryAt              DateTime @default(now()) @map("retry_at")
  attempts             Int @default(0)
  confirmedAt          DateTime? @map("confirmed_at")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@unique([orderId, requestId], map: "refund_requests_order_request_key")
  @@index([orderId, status])
  @@index([status, retryAt])
  @@index([paymentTransactionId])
  @@map("refund_requests")
  @@index([status,confirmedAt,currency])
}

// 04D-1: One all-lines shipment per PAID order; no partial fulfillment or carrier integration.
// Shipment status is separate from payment/order status and NEVER mutates inventory.
enum FulfillmentStatus {
  PROCESSING
  SHIPPED
  DELIVERED
}

model OrderShipment {
  id             String            @id @default(uuid()) @db.Uuid
  orderId        String            @unique @map("order_id") @db.Uuid
  order          Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  status         FulfillmentStatus @default(PROCESSING)
  carrier        String?           @db.VarChar(80)
  trackingNumber String?           @map("tracking_number") @db.VarChar(120)
  startedAt      DateTime          @default(now()) @map("started_at")
  shippedAt      DateTime?         @map("shipped_at")
  deliveredAt    DateTime?         @map("delivered_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  events         OrderShipmentEvent[]

  @@index([status, startedAt])
  @@map("order_shipments")
}

model OrderShipmentEvent {
  id          String            @id @default(uuid()) @db.Uuid
  shipmentId  String            @map("shipment_id") @db.Uuid
  shipment    OrderShipment     @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderId     String            @map("order_id") @db.Uuid
  requestId   String            @map("request_id") @db.Uuid
  requestHash String            @map("request_hash") @db.VarChar(64)
  status      FulfillmentStatus
  actorId     String            @map("actor_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at")

  @@unique([orderId, requestId], map: "order_shipment_events_order_request_key")
  @@index([shipmentId, createdAt])
  @@map("order_shipment_events")
}

// 04D-2A: Returns are separate from financial refunds. Receipt alone never
// increases stock; only inspection-approved RESTOCKABLE units may be restocked.
enum OrderReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
  RECEIVED_RESTOCKABLE
  RECEIVED_DAMAGED
  RESTOCKED
}

model OrderReturn {
  id           String            @id @default(uuid()) @db.Uuid
  orderId      String            @map("order_id") @db.Uuid
  order        Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderLineId  String            @map("order_line_id") @db.Uuid
  orderLine    OrderLine         @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  requestId    String            @map("request_id") @db.Uuid
  requestHash  String            @map("request_hash") @db.VarChar(64)
  quantity     Int
  reason       String            @db.VarChar(32)
  status       OrderReturnStatus @default(REQUESTED)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  events       OrderReturnEvent[]
  replacement  OrderReplacement?

  @@unique([orderId, requestId], map: "order_returns_order_request_key")
  @@index([orderLineId, status])
  @@index([orderId, createdAt])
  @@map("order_returns")
}

model OrderReturnEvent {
  id          String            @id @default(uuid()) @db.Uuid
  returnId    String            @map("return_id") @db.Uuid
  orderReturn OrderReturn       @relation(fields: [returnId], references: [id], onDelete: Cascade)
  requestId   String            @map("request_id") @db.Uuid
  action      String            @db.VarChar(24)
  actionHash  String            @map("action_hash") @db.VarChar(64)
  status      OrderReturnStatus
  actorId     String            @map("actor_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at")

  @@unique([returnId, requestId], map: "order_return_events_return_request_key")
  @@index([returnId, createdAt])
  @@map("order_return_events")
}

// 04D-2B / G1 increment: free, same-SKU replacement authorization/dispatch.
// This is NOT a new paid Order, nor a refund, nor an automatic return restock.
// Shipment records and payment/financial snapshots of the original Order are immutable.
enum ReplacementStatus {
  AUTHORIZED
  SHIPPED
  DELIVERED
  CANCELLED
}

model OrderReplacement {
  id             String            @id @default(uuid()) @db.Uuid
  orderId        String            @map("order_id") @db.Uuid
  order          Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  returnId       String            @unique @map("return_id") @db.Uuid
  orderReturn    OrderReturn       @relation(fields: [returnId], references: [id], onDelete: Restrict)
  requestId      String            @map("request_id") @db.Uuid
  requestHash    String            @map("request_hash") @db.VarChar(64)
  productId      String            @map("product_id") @db.Uuid
  variantId      String?           @map("variant_id") @db.Uuid
  skuSnapshot    String?           @map("sku_snapshot") @db.VarChar(120)
  quantity       Int
  status         ReplacementStatus @default(AUTHORIZED)
  carrier        String?           @db.VarChar(80)
  trackingNumber String?           @map("tracking_number") @db.VarChar(120)
  shippedAt      DateTime?         @map("shipped_at")
  deliveredAt    DateTime?         @map("delivered_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  events         OrderReplacementEvent[]

  @@unique([orderId, requestId], map: "order_replacements_order_request_key")
  @@index([orderId, createdAt])
  @@map("order_replacements")
}

model OrderReplacementEvent {
  id            String           @id @default(uuid()) @db.Uuid
  replacementId String           @map("replacement_id") @db.Uuid
  replacement   OrderReplacement @relation(fields: [replacementId], references: [id], onDelete: Cascade)
  requestId     String           @map("request_id") @db.Uuid
  requestHash   String           @map("request_hash") @db.VarChar(64)
  action        String           @db.VarChar(20)
  actorId       String           @map("actor_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at")

  @@unique([replacementId, requestId], map: "order_replacement_events_request_key")
  @@index([replacementId, createdAt])
  @@map("order_replacement_events")
}

// G3/05B-1: exactly one profile per independently deployed single-tenant shop.
// This is NOT a tenant registry and must not be seeded from Admin preview fixtures.
model StoreProfile {
  key           String   @id @db.VarChar(20)
  storeName     String   @map("store_name") @db.VarChar(70)
  supportEmail  String   @map("support_email") @db.VarChar(120)
  websiteUrl    String   @default("") @map("website_url") @db.VarChar(200)
  timezone      String   @db.VarChar(64)
  supportNotice String   @default("") @map("support_notice") @db.VarChar(180)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("store_profiles")
}


// G3/05B-2. Optional public plain-text content; keep out of checkout/order/payment.
// Explicit no-content response when absent; no demo-brand data seed.
model StoreContent {
  key            String   @id @db.VarChar(20)
  revision       Int      @default(1)
  seoTitle       String   @default("") @map("seo_title") @db.VarChar(70)
  seoDescription String   @default("") @map("seo_description") @db.VarChar(180)
  footerText     String   @default("") @map("footer_text") @db.VarChar(240)
  privacyPolicy  String   @default("") @map("privacy_policy") @db.Text
  termsOfService String   @default("") @map("terms_of_service") @db.Text
  returnPolicy   String   @default("") @map("return_policy") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("store_contents")
}

// G3/05B-3: verified media bindings. Both references protect shared provider assets
// against cleanup. One single-tenant store; never accept raw provider URLs.
model StoreBranding {
  key           String      @id @db.VarChar(20)
  revision      Int         @default(1)
  logoMediaId   String?     @map("logo_media_id") @db.Uuid
  logoMedia     MediaAsset? @relation("StoreBrandLogo", fields: [logoMediaId], references: [id], onDelete: Restrict)
  faviconMediaId String?    @map("favicon_media_id") @db.Uuid
  faviconMedia  MediaAsset? @relation("StoreBrandFavicon", fields: [faviconMediaId], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([logoMediaId])
  @@index([faviconMediaId])
  @@map("store_brandings")
}

// G3/05B-5: public presentation metadata. Never authorizes CORS or payment.
// Per-installation origins remain deployment-managed CORS_ORIGINS.
model StoreOperations {
  key               String   @id @db.VarChar(20)
  revision          Int      @default(1)
  locale            String   @default("en-US") @db.VarChar(16)
  displayCurrency   String   @default("USD") @map("display_currency") @db.VarChar(3)
  orderPrefix       String   @default("KB") @map("order_prefix") @db.VarChar(8)
  themeMode         String   @default("system") @map("theme_mode") @db.VarChar(8)
  accentColor       String   @default("#1F2937") @map("accent_color") @db.VarChar(7)
  storefrontOrigin  String   @default("") @map("storefront_origin") @db.VarChar(200)
  adminOrigin       String   @default("") @map("admin_origin") @db.VarChar(200)
  showWishlist      Boolean  @default(true) @map("show_wishlist")
  showPolicies      Boolean  @default(true) @map("show_policies")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("store_operations")
}

enum DeliveryKind {
  STANDARD
  EXPRESS
}

// Countries are unique within each configured currency; no cross-currency fallback.
// A zone groups country/currency lanes; shipping is in integer minor units.
model DeliveryZone {
  id        String                @id @default(uuid()) @db.Uuid
  name      String                @db.VarChar(80)
  currency  String                @db.VarChar(3)
  enabled   Boolean               @default(true)
  revision  Int                   @default(1)
  countries DeliveryZoneCountry[]
  services  DeliveryZoneService[]
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")

  @@unique([name, currency], map: "delivery_zones_name_currency_key")
  @@map("delivery_zones")
}

model DeliveryZoneCountry {
  countryCode String       @map("country_code") @db.VarChar(2)
  currency    String       @db.VarChar(3)
  zoneId      String       @map("zone_id") @db.Uuid
  zone        DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@id([countryCode, currency])
  @@index([zoneId])
  @@map("delivery_zone_countries")
}

model DeliveryZoneService {
  id                    String       @id @default(uuid()) @db.Uuid
  zoneId                String       @map("zone_id") @db.Uuid
  zone                  DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  kind                  DeliveryKind
  shippingMinor         Int          @map("shipping_minor")
  freeOverSubtotalMinor Int?         @map("free_over_subtotal_minor")
  etaNote               String       @default("") @map("eta_note") @db.VarChar(100)
  enabled               Boolean      @default(true)

  @@unique([zoneId, kind], map: "delivery_zone_services_zone_kind_key")
  @@map("delivery_zone_services")
}

// G4: revisioned promotion rules and a durable reservation-linked quota ledger.
enum CouponKind {
  PERCENT
  FIXED
}
enum PromotionCampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
}
model PromotionCampaign {
  id String @id @default(uuid()) @db.Uuid
  title String @db.VarChar(120)
  slug String @unique @db.VarChar(120)
  description String @db.VarChar(2000)
  status PromotionCampaignStatus @default(DRAFT)
  startsAt DateTime? @map("starts_at")
  endsAt DateTime? @map("ends_at")
  revision Int @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  coupons Coupon[]
  @@index([status, startsAt, endsAt])
  @@map("promotion_campaigns")
}
model Coupon {
  id String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(24)
  kind CouponKind
  value Int
  currency String @db.VarChar(3)
  minimumSubtotalMinor Int @default(0) @map("minimum_subtotal_minor")
  maximumDiscountMinor Int? @map("maximum_discount_minor")
  usageLimit Int? @map("usage_limit")
  perCustomerLimit Int? @map("per_customer_limit")
  startsAt DateTime? @map("starts_at")
  endsAt DateTime? @map("ends_at")
  categoryId String? @map("category_id") @db.Uuid
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  campaignId String? @map("campaign_id") @db.Uuid
  campaign PromotionCampaign? @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  enabled Boolean @default(false)
  revision Int @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  redemptions CouponRedemption[]
  @@index([categoryId])
  @@index([campaignId])
  @@map("coupons")
}
model CouponRedemption {
  id String @id @default(uuid()) @db.Uuid
  couponId String @map("coupon_id") @db.Uuid
  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  reservationId String @unique @map("reservation_id") @db.Uuid
  reservation CheckoutReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  customerId String @map("customer_id") @db.Uuid
  discountMinor Int @map("discount_minor")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([couponId, customerId])
  @@map("coupon_redemptions")
}

// G5: scheduled public merchandising; draft references still protect shared media.
enum ContentPublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
model StoreBanner {
  id String @id @default(uuid()) @db.Uuid
  headline String @db.VarChar(160)
  subtitle String @db.VarChar(500)
  ctaText String @map("cta_text") @db.VarChar(60)
  ctaHref String @map("cta_href") @db.VarChar(300)
  slot String @db.VarChar(20)
  position Int
  status ContentPublicationStatus @default(DRAFT)
  startsAt DateTime? @map("starts_at")
  endsAt DateTime? @map("ends_at")
  imageMediaId String? @map("image_media_id") @db.Uuid
  imageMedia MediaAsset? @relation(fields: [imageMediaId], references: [id], onDelete: Restrict)
  imageAlt String @map("image_alt") @db.VarChar(250)
  revision Int @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([status, position])
  @@index([imageMediaId])
  @@map("store_banners")
}
model FeaturedCollection {
  id String @id @default(uuid()) @db.Uuid
  slug String @unique @db.VarChar(120)
  title String @db.VarChar(120)
  description String @db.VarChar(1000)
  position Int
  status ContentPublicationStatus @default(DRAFT)
  startsAt DateTime? @map("starts_at")
  endsAt DateTime? @map("ends_at")
  revision Int @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  products FeaturedCollectionProduct[]
  @@index([status, position])
  @@map("featured_collections")
}
model FeaturedCollectionProduct {
  collectionId String @map("collection_id") @db.Uuid
  collection FeaturedCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId String @map("product_id") @db.Uuid
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  position Int
  @@id([collectionId, productId])
  @@unique([collectionId, position])
  @@index([productId])
  @@map("featured_collection_products")
}


// G6: independent subscriber receipt; never consumes another worker's outbox status.
model NotificationEventReceipt {
  eventId String @id @map("event_id") @db.Uuid
  event OutboxEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status String @default("PENDING") @db.VarChar(20)
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at")
  failureCode String? @map("failure_code") @db.VarChar(60)
  processedAt DateTime? @map("processed_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([status, nextAttemptAt])
  @@map("notification_event_receipts")
}
model Notification {
  campaignId String? @map("campaign_id") @db.Uuid
  campaign PushCampaign? @relation(fields:[campaignId],references:[id],onDelete:Restrict)
  imageMediaId String? @map("image_media_id") @db.Uuid
  imageMedia MediaAsset? @relation(fields:[imageMediaId],references:[id],onDelete:Restrict)
  id String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid
  kind String @db.VarChar(60)
  audience String @db.VarChar(20)
  permissionKey String? @map("permission_key") @db.VarChar(80)
  title String @db.VarChar(160)
  body String @db.VarChar(600)
  targetType String @map("target_type") @db.VarChar(30)
  targetId String? @map("target_id") @db.Uuid
  templateRevision Int @map("template_revision")
  createdAt DateTime @default(now()) @map("created_at")
  recipients NotificationRecipient[]
  @@index([imageMediaId])
  @@index([campaignId])
  @@unique([eventId, audience])
  @@index([createdAt, id])
  @@map("notifications")
}
model NotificationRecipient {
  id String @id @default(uuid()) @db.Uuid
  notificationId String @map("notification_id") @db.Uuid
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId String @map("user_id") @db.Uuid
